# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.

# Metals data provider — metalpriceapi.com. SERVER-ONLY: never prefix with NEXT_PUBLIC_,
# or it ships in the browser bundle for anyone to read and burn (which is exactly what
# the previous version of this site did).
#
# ⚠️ The key that was hardcoded in the old GoldPrices.tsx is public in the git history
# and must be treated as compromised. Rotate it in the metalpriceapi dashboard and put
# the NEW key here.
METAL_PRICE_API_KEY=

# Resend — delivers the contact form to the address in app/lib/site.ts.
RESEND_API_KEY=

# Sender address for contact-form email. Must be on a domain verified in Resend
# (e.g. website@gpr8.com). Without it we fall back to Resend's shared test sender,
# which is fine locally but will land in spam for real traffic.
CONTACT_FROM=
